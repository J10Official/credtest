# MWAHAHA Pipeline Environment Variables

# =========================================================================
# API KEYS
# =========================================================================

# Google Gemini API Key (required for default provider)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (optional, for future use)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =========================================================================
# PROVIDER SELECTION
# =========================================================================

# Current API provider: "gemini" or "openrouter"
API_PROVIDER=gemini
